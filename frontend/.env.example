# Public base URL of this Next.js application. Local development only.
AUTH_URL=http://localhost:3000

# OpenIddict issuer reachable by the Next.js server.
AUTH_OIDC_ISSUER=http://localhost:5130/
AUTH_OIDC_CLIENT_ID=portfolio-web

# nginx gateway used by the Next.js server to reach protected business APIs.
BACKEND_API_ORIGIN=http://localhost/

# Set through the narrow application process with secrets-run. Never commit values.
AUTH_SECRET=
AUTH_OIDC_CLIENT_SECRET=
DATABASE_URL=
