{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DirectoryService": "Information"
    }
  },
  "ConnectionStrings": {
    "DirectoryServiceDb": "Server=localhost;Port=5434;Database=platform;User Id=postgres;Password=postgres;Search Path=directory,public"
  },
  "ClearDbOptions": {
    "Interval": "24:00:00"
  },
  "Auth": {
    "MetadataAddress": "http://localhost:5130/.well-known/openid-configuration",
    "Issuer": "http://localhost:5130/"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Embeddings": {
    "OllamaBaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "DirectoryService": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "MyAwesomeApp"
    }
  },
  "AllowedHosts": "*"
}
