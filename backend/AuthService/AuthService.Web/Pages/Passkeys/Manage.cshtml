@page "/auth/passkeys/manage"
@model AuthService.Web.Pages.Passkeys.ManageModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Passkeys · DS</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #131a17; color: #f0f4f1; }
        body { margin: 0; min-height: 100dvh; display: grid; place-items: center; }
        main { width: min(32rem, calc(100% - 3rem)); padding-block: 3rem; }
        .brand { font-weight: 700; letter-spacing: .15em; color: #a8d7b8; }
        h1 { font-size: 2rem; letter-spacing: -.03em; margin-bottom: .75rem; }
        h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; }
        p { color: #abb9b0; line-height: 1.6; }
        input, button { box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; font: inherit; }
        input { background: #1c2520; color: #f0f4f1; border: 1px solid #53685b; margin-bottom: .5rem; }
        button { border: 0; background: #a8d7b8; color: #131a17; font-weight: 600; cursor: pointer; margin-top: .5rem; }
        button.secondary { background: transparent; border: 1px solid #53685b; color: #f0f4f1; }
        button:disabled { opacity: .6; cursor: default; }
        .passkey-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: #1c2520; border: 1px solid #53685b; border-radius: .75rem; padding: .875rem 1rem; margin-bottom: .5rem; }
        .passkey-row__meta { font-size: .85rem; color: #abb9b0; }
        .passkey-row button { width: auto; margin: 0; padding: .5rem .875rem; background: transparent; border: 1px solid #53685b; color: #ffb5b5; }
        .message { border-radius: .75rem; padding: .875rem 1rem; margin: 1rem 0; }
        .message--error { border: 1px solid #a83a3a; background: #2c1313; color: #ffb5b5; }
        .message--empty { color: #abb9b0; font-size: .9rem; }
    </style>
</head>
<body>
<main>
    <div class="brand">DS / PEOPLE &amp; ORGANIZATION</div>
    <h1>Passkeys</h1>
    <p>Sign in to <strong>@Model.Email</strong> with a fingerprint, face, or security key instead
       of a password - a passkey works from the sign-in page with no email needed, and is
       resistant to phishing the way a password never can be.</p>

    <div id="message"></div>
    <p><a href="/auth/2fa/manage">Manage two-factor authentication →</a> · <a href="/auth/sessions/manage">View active sessions →</a> · <a href="/auth/account/settings">Account settings →</a></p>

    <h2>Your passkeys</h2>
    <div id="passkey-list"><p class="message--empty">Loading…</p></div>

    <h2>Add a passkey</h2>
    <input id="label" type="text" placeholder="e.g. MacBook Touch ID" maxlength="100" autocomplete="off" />
    <button id="register-button" type="button">Register a new passkey</button>
</main>
<script>
    function base64UrlToBuffer(base64url) {
        const padding = "=".repeat((4 - (base64url.length % 4)) % 4);
        const base64 = (base64url + padding).replace(/-/g, "+").replace(/_/g, "/");
        const raw = atob(base64);
        const bytes = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
        return bytes.buffer;
    }

    function bufferToBase64Url(buffer) {
        const bytes = new Uint8Array(buffer);
        let str = "";
        for (const b of bytes) str += String.fromCharCode(b);
        return btoa(str).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }

    function escapeHtml(value) {
        const div = document.createElement("div");
        div.textContent = value;
        return div.innerHTML;
    }

    function showMessage(text) {
        document.getElementById("message").innerHTML = text
            ? `<div class="message message--error" role="alert">${text}</div>`
            : "";
    }

    async function loadPasskeys() {
        const response = await fetch("/auth/passkeys");
        const list = document.getElementById("passkey-list");
        if (!response.ok) {
            list.innerHTML = '<p class="message--empty">Could not load your passkeys.</p>';
            return;
        }

        const passkeys = await response.json();
        if (passkeys.length === 0) {
            list.innerHTML = '<p class="message--empty">No passkeys registered yet.</p>';
            return;
        }

        list.innerHTML = passkeys.map((p) => `
            <div class="passkey-row">
                <div>
                    <div>${escapeHtml(p.name)}</div>
                    <div class="passkey-row__meta">Added ${new Date(p.createdAt).toLocaleDateString()}${p.lastUsedAt ? " · last used " + new Date(p.lastUsedAt).toLocaleDateString() : ""}</div>
                </div>
                <button type="button" data-delete="${p.id}">Remove</button>
            </div>
        `).join("");

        list.querySelectorAll("[data-delete]").forEach((button) => {
            button.addEventListener("click", async () => {
                button.disabled = true;
                const deleteResponse = await fetch(`/auth/passkeys/${button.dataset.delete}`, { method: "DELETE" });
                if (deleteResponse.ok) {
                    await loadPasskeys();
                } else {
                    showMessage("Could not remove that passkey.");
                    button.disabled = false;
                }
            });
        });
    }

    document.getElementById("register-button").addEventListener("click", async () => {
        showMessage("");

        if (!window.PublicKeyCredential) {
            showMessage("This browser does not support passkeys.");
            return;
        }

        const label = document.getElementById("label").value.trim() || "Passkey";
        const optionsResponse = await fetch("/auth/passkeys/register/options", { method: "POST" });
        if (!optionsResponse.ok) {
            showMessage("Could not start passkey registration.");
            return;
        }

        const { token, optionsJson } = await optionsResponse.json();
        const options = JSON.parse(optionsJson);

        const publicKey = {
            ...options,
            challenge: base64UrlToBuffer(options.challenge),
            user: { ...options.user, id: base64UrlToBuffer(options.user.id) },
            excludeCredentials: (options.excludeCredentials || []).map((c) => ({ ...c, id: base64UrlToBuffer(c.id) })),
        };

        let credential;
        try {
            credential = await navigator.credentials.create({ publicKey });
        } catch {
            showMessage("Passkey registration was cancelled or not completed.");
            return;
        }

        const attestation = {
            id: credential.id,
            rawId: bufferToBase64Url(credential.rawId),
            type: credential.type,
            response: {
                attestationObject: bufferToBase64Url(credential.response.attestationObject),
                clientDataJSON: bufferToBase64Url(credential.response.clientDataJSON),
                transports: credential.response.getTransports ? credential.response.getTransports() : [],
            },
        };

        const completeResponse = await fetch("/auth/passkeys/register/complete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, label, attestation }),
        });

        if (completeResponse.ok) {
            document.getElementById("label").value = "";
            await loadPasskeys();
        } else {
            showMessage("That passkey could not be registered.");
        }
    });

    loadPasskeys();
</script>
</body>
</html>
