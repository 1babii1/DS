@page "/auth/sign-up"
@model AuthService.Web.Pages.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var passwordInput = new AuthService.Web.Pages.Shared.PasswordInputModel("new-password", "password-error", "Password", "Password", "Password");
    var confirmPasswordInput = new AuthService.Web.Pages.Shared.PasswordInputModel("new-password", "confirm-password-error", "ConfirmPassword", "Confirm password", "ConfirmPassword");
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Create account · DS</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #131a17; color: #f0f4f1; }
        body { margin: 0; min-height: 100dvh; display: grid; place-items: center; }
        main { width: min(26rem, calc(100% - 3rem)); padding-block: 3rem; }
        .brand { font-weight: 700; letter-spacing: .15em; color: #a8d7b8; }
        h1 { font-size: 2.5rem; letter-spacing: -.04em; margin-bottom: .75rem; }
        p { color: #abb9b0; line-height: 1.6; }
        form { display: grid; gap: .75rem; margin-top: 2rem; }
        input, button { box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; font: inherit; }
        input { background: #1c2520; color: #f0f4f1; border: 1px solid #53685b; margin-bottom: .5rem; }
        input:focus-visible, button:focus-visible { outline: 3px solid #a8d7b8; outline-offset: 3px; }
        button { border: 0; background: #a8d7b8; color: #131a17; font-weight: 600; cursor: pointer; margin-top: .75rem; }
        .button-link { display: block; box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; margin-top: .75rem; text-align: center; text-decoration: none; font-weight: 600; background: transparent; border: 1px solid #53685b; color: #f0f4f1; }
        .password-field { position: relative; margin-bottom: .5rem; }
        .password-field input { display: block; margin-bottom: 0; padding-right: 3.5rem; }
        .password-toggle { position: absolute; top: 0; right: 0; width: 3.25rem; height: 100%; margin: 0; padding: 0; border: 0; background: transparent; color: #a8d7b8; }
        .password-toggle__icon { position: relative; display: block; width: 1.15rem; height: .72rem; margin: auto; border: 2px solid currentColor; border-radius: 50%; }
        .password-toggle__icon::after { content: ""; position: absolute; top: 50%; left: 50%; width: .28rem; height: .28rem; transform: translate(-50%, -50%); border-radius: 50%; background: currentColor; }
        .password-toggle[data-visible="true"] .password-toggle__icon::before { content: ""; position: absolute; top: 50%; left: 50%; width: 1.4rem; height: 2px; transform: translate(-50%, -50%) rotate(-45deg); background: #a8d7b8; }
        .validation-summary-errors, .field-validation-error { color: #ffb5b5; }
        .validation-summary-valid { display: none; }
        .auth-switch { margin: 1.5rem 0 0; font-size: .9rem; }
        .auth-switch a { color: #a8d7b8; font-weight: 600; }
    </style>
</head>
<body>
<main>
    <div class="brand">DS / PEOPLE &amp; ORGANIZATION</div>
    @if (Model.Registered)
    {
        <h1>Check your email.</h1>
        <p>We sent a confirmation link to @Model.Email. Follow it to activate your account, then sign in.</p>
        <p class="auth-switch"><a href="/auth/sign-in?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">Back to sign in</a></p>
    }
    else
    {
        <h1>Create your account.</h1>
        <p>Start with viewer access. An administrator can grant additional permissions later.</p>
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <label asp-for="Email">Work email</label>
            <input asp-for="Email" autocomplete="email" required aria-describedby="email-error" />
            <span asp-validation-for="Email" id="email-error"></span>
            <partial name="Shared/_PasswordInput" model="passwordInput" />
            <span asp-validation-for="Password" id="password-error"></span>
            <partial name="Shared/_PasswordInput" model="confirmPasswordInput" />
            <span asp-validation-for="ConfirmPassword" id="confirm-password-error"></span>
            <button type="submit">Create viewer account</button>
            @if (Model.GoogleSignInEnabled)
            {
                <a class="button-link secondary" href="/auth/external/google/start?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">Sign up with Google</a>
            }
            <p class="auth-switch">Already have an account? <a href="/auth/sign-in?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">Sign in</a></p>
        </form>
    }
</main>
<script>
    document.querySelectorAll("[data-password-toggle]").forEach((passwordToggle) => {
        const passwordInput = document.getElementById(passwordToggle.dataset.target);

        passwordToggle.addEventListener("click", () => {
            const visible = passwordInput.type === "text";
            passwordInput.type = visible ? "password" : "text";
            passwordToggle.dataset.visible = String(!visible);
            passwordToggle.setAttribute("aria-pressed", String(!visible));
            passwordToggle.setAttribute("aria-label", visible ? "Show password" : "Hide password");
        });
    });
</script>
</body>
</html>
