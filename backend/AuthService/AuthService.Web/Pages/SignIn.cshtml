@page "/auth/sign-in"
@model AuthService.Web.Pages.SignInModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var passwordInput = new AuthService.Web.Pages.Shared.PasswordInputModel("current-password", "password-error", "Password", "Password", "Password");
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Sign in · DS</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #131a17; color: #f0f4f1; }
        body { margin: 0; min-height: 100dvh; display: grid; place-items: center; }
        main { width: min(26rem, calc(100% - 3rem)); padding-block: 3rem; }
        .brand { font-weight: 700; letter-spacing: .15em; color: #a8d7b8; }
        h1 { font-size: 2.5rem; letter-spacing: -.04em; margin-bottom: .75rem; }
        p { color: #abb9b0; line-height: 1.6; }
        form { display: grid; gap: .75rem; margin-top: 2rem; }
        input, button { box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; font: inherit; }
        input { background: #1c2520; color: #f0f4f1; border: 1px solid #53685b; margin-bottom: .5rem; }
        input:focus-visible, button:focus-visible { outline: 3px solid #a8d7b8; outline-offset: 3px; }
        button { border: 0; background: #a8d7b8; color: #131a17; font-weight: 600; cursor: pointer; margin-top: .75rem; }
        button.secondary, .button-link { background: transparent; border: 1px solid #53685b; color: #f0f4f1; }
        .button-link { display: block; box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; margin-top: .75rem; text-align: center; text-decoration: none; font-weight: 600; }
        .password-field { position: relative; margin-bottom: .5rem; }
        .password-field input { display: block; margin-bottom: 0; padding-right: 3.5rem; }
        .password-toggle { position: absolute; top: 0; right: 0; width: 3.25rem; height: 100%; margin: 0; padding: 0; border: 0; background: transparent; color: #a8d7b8; }
        .password-toggle__icon { position: relative; display: block; width: 1.15rem; height: .72rem; margin: auto; border: 2px solid currentColor; border-radius: 50%; }
        .password-toggle__icon::after { content: ""; position: absolute; top: 50%; left: 50%; width: .28rem; height: .28rem; transform: translate(-50%, -50%); border-radius: 50%; background: currentColor; }
        .password-toggle[data-visible="true"] .password-toggle__icon::before { content: ""; position: absolute; top: 50%; left: 50%; width: 1.4rem; height: 2px; transform: translate(-50%, -50%) rotate(-45deg); background: #a8d7b8; }
        .validation-summary-errors, .field-validation-error { color: #ffb5b5; }
        .validation-summary-valid { display: none; }
    </style>
</head>
<body>
<main>
    <div class="brand">DS / PEOPLE &amp; ORGANIZATION</div>
    <h1>Welcome back.</h1>
    <p>Sign in to your organization's workspace.</p>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <label asp-for="Email">Work email</label>
        <input asp-for="Email" autocomplete="username" required aria-describedby="email-error" />
        <span asp-validation-for="Email" id="email-error"></span>
        <partial name="Shared/_PasswordInput" model="passwordInput" />
        <span asp-validation-for="Password" id="password-error"></span>
        <button type="submit">Sign in</button>
        @if (Model.EmailNotConfirmed)
        {
            <button asp-page-handler="ResendConfirmation" formnovalidate type="submit">Resend confirmation email</button>
        }
        <button id="passkey-button" type="button" class="secondary" hidden>Sign in with a passkey</button>
        <p id="passkey-message" class="field-validation-error" role="alert" hidden></p>
        @if (Model.GoogleSignInEnabled)
        {
            <a class="button-link secondary" href="/auth/external/google/start?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">Sign in with Google</a>
        }
        <p class="auth-switch">
            <a href="/auth/password/forgot?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">Forgot password?</a>
        </p>
        <p class="auth-switch">New here? <a href="/auth/sign-up?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">Create a viewer account</a></p>
    </form>
</main>
<script>
    document.querySelectorAll("[data-password-toggle]").forEach((passwordToggle) => {
        const passwordInput = document.getElementById(passwordToggle.dataset.target);

        passwordToggle.addEventListener("click", () => {
            const visible = passwordInput.type === "text";
            passwordInput.type = visible ? "password" : "text";
            passwordToggle.dataset.visible = String(!visible);
            passwordToggle.setAttribute("aria-pressed", String(!visible));
            passwordToggle.setAttribute("aria-label", visible ? "Show password" : "Hide password");
        });
    });

    function base64UrlToBuffer(base64url) {
        const padding = "=".repeat((4 - (base64url.length % 4)) % 4);
        const base64 = (base64url + padding).replace(/-/g, "+").replace(/_/g, "/");
        const raw = atob(base64);
        const bytes = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
        return bytes.buffer;
    }

    function bufferToBase64Url(buffer) {
        const bytes = new Uint8Array(buffer);
        let str = "";
        for (const b of bytes) str += String.fromCharCode(b);
        return btoa(str).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }

    const passkeyButton = document.getElementById("passkey-button");
    const passkeyMessage = document.getElementById("passkey-message");

    // Only offered when the browser can plausibly do it - PublicKeyCredential existing does
    // not guarantee a passkey is actually saved for this site, only that the ceremony itself
    // is possible; navigator.credentials.get simply returns nothing selectable otherwise.
    if (window.PublicKeyCredential) {
        passkeyButton.hidden = false;
    }

    passkeyButton.addEventListener("click", async () => {
        passkeyMessage.hidden = true;

        const optionsResponse = await fetch("/auth/passkeys/login/options", { method: "POST" });
        if (!optionsResponse.ok) {
            return;
        }

        const { token, optionsJson } = await optionsResponse.json();
        const options = JSON.parse(optionsJson);

        const publicKey = {
            ...options,
            challenge: base64UrlToBuffer(options.challenge),
            allowCredentials: (options.allowCredentials || []).map((c) => ({ ...c, id: base64UrlToBuffer(c.id) })),
        };

        let credential;
        try {
            credential = await navigator.credentials.get({ publicKey });
        } catch {
            return;
        }

        const assertion = {
            id: credential.id,
            rawId: bufferToBase64Url(credential.rawId),
            type: credential.type,
            response: {
                authenticatorData: bufferToBase64Url(credential.response.authenticatorData),
                clientDataJSON: bufferToBase64Url(credential.response.clientDataJSON),
                signature: bufferToBase64Url(credential.response.signature),
                userHandle: credential.response.userHandle ? bufferToBase64Url(credential.response.userHandle) : null,
            },
        };

        const completeResponse = await fetch("/auth/passkeys/login/complete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, assertion }),
        });

        if (completeResponse.ok) {
            window.location.href = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReturnUrl ?? "/"));
        } else {
            passkeyMessage.textContent = "Passkey sign-in failed. Check your details or try again.";
            passkeyMessage.hidden = false;
        }
    });
</script>
</body>
</html>
