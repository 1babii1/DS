@page "/auth/login/2fa"
@model AuthService.Web.Pages.TwoFactor.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Verify your identity · DS</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #131a17; color: #f0f4f1; }
        body { margin: 0; min-height: 100dvh; display: grid; place-items: center; }
        main { width: min(26rem, calc(100% - 3rem)); padding-block: 3rem; }
        .brand { font-weight: 700; letter-spacing: .15em; color: #a8d7b8; }
        h1 { font-size: 2.5rem; letter-spacing: -.04em; margin-bottom: .75rem; }
        p { color: #abb9b0; line-height: 1.6; }
        form { display: grid; gap: .75rem; margin-top: 2rem; }
        input, button { box-sizing: border-box; width: 100%; border-radius: .75rem; padding: .875rem 1rem; font: inherit; }
        input { background: #1c2520; color: #f0f4f1; border: 1px solid #53685b; margin-bottom: .5rem; letter-spacing: .3em; text-align: center; font-size: 1.25rem; }
        input:focus-visible, button:focus-visible { outline: 3px solid #a8d7b8; outline-offset: 3px; }
        button { border: 0; background: #a8d7b8; color: #131a17; font-weight: 600; cursor: pointer; margin-top: .75rem; }
        label.checkbox { display: flex; align-items: center; gap: .5rem; font-size: .9rem; color: #abb9b0; }
        label.checkbox input { width: auto; margin: 0; }
        .validation-summary-errors, .field-validation-error { color: #ffb5b5; }
        .validation-summary-valid { display: none; }
        .auth-switch { margin: 1.5rem 0 0; font-size: .9rem; }
        .auth-switch a { color: #a8d7b8; font-weight: 600; }
    </style>
</head>
<body>
<main>
    <div class="brand">DS / PEOPLE &amp; ORGANIZATION</div>
    <h1>Enter your code.</h1>
    <p>Open your authenticator app and enter the 6-digit code for this account.</p>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <label asp-for="Code">Authenticator code</label>
        <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" placeholder="123 456" required aria-describedby="code-error" />
        <span asp-validation-for="Code" id="code-error"></span>
        <label class="checkbox"><input asp-for="RememberClient" /> Remember this browser for 30 days</label>
        <button type="submit">Verify</button>
        <p class="auth-switch"><a href="/auth/login/2fa-recovery?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">Use a recovery code instead</a></p>
    </form>
</main>
</body>
</html>
