@model AuthService.Web.Pages.Shared.PasswordInputModel

<label for="@Model.Id">@Model.Label</label>
<div class="password-field">
    <input aria-describedby="@Model.ErrorId" autocomplete="@Model.Autocomplete" id="@Model.Id" name="@Model.Name" required type="password" />
    <button aria-label="Show @Model.Label.ToLowerInvariant()" aria-pressed="false" class="password-toggle" data-password-toggle data-visible="false" data-target="@Model.Id" type="button">
        <span aria-hidden="true" class="password-toggle__icon"></span>
    </button>
</div>
