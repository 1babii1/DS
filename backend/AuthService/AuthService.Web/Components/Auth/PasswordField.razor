<div class="password-field">
    <input id="@Id" name="@Name" type="password" value="@Value" autocomplete="@Autocomplete" required aria-describedby="@DescribedBy" data-password-input />
    <button class="password-toggle" type="button" data-password-toggle data-target="@Id" aria-label="Show password" aria-pressed="false">
        <span class="password-toggle__icon" aria-hidden="true"></span>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string Autocomplete { get; set; } = "current-password";

    [Parameter]
    public string? DescribedBy { get; set; }
}
