@page "/auth/password/reset"
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting("auth")]
@attribute [ResponseCache(NoStore = true, Location = ResponseCacheLocation.None)]
@attribute [ExcludeFromInteractiveRouting]
@inject AccountRecoveryService Recovery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Reset password · DS</PageTitle>

@if (Completed)
{
    <h1 id="page-title">Password updated.</h1>
    <p>You can now sign in with your new password.</p>
    <p class="auth-link"><a href="/auth/sign-in">Sign in</a></p>
}
else if (InvalidLink)
{
    <h1 id="page-title">Link invalid or expired.</h1>
    <p>Request a new reset link from the sign-in page.</p>
}
else
{
    <h1 id="page-title">Choose a new password.</h1>
    <EditForm FormName="reset-password" Model="Form!" OnValidSubmit="SubmitAsync" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        @if (FormError is not null)
        {
            <p class="form-error" role="alert">@FormError</p>
        }
        <input name="Form.Email" type="hidden" value="@Form!.Email" />
        <input name="Form.Token" type="hidden" value="@Form!.Token" />
        <label for="new-password">New password</label>
        <PasswordField Id="new-password" Name="Form.NewPassword" Value="Form!.NewPassword" Autocomplete="new-password" DescribedBy="new-password-error" />
        <ValidationMessage For="() => Form!.NewPassword" id="new-password-error" />
        <label for="confirm-password">Confirm new password</label>
        <PasswordField Id="confirm-password" Name="Form.ConfirmPassword" Value="Form!.ConfirmPassword" Autocomplete="new-password" DescribedBy="confirm-password-error" />
        <ValidationMessage For="() => Form!.ConfirmPassword" id="confirm-password-error" />
        <button type="submit">Update password</button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordForm? Form { get; set; }

        private bool Completed { get; set; }

    private bool InvalidLink { get; set; }

    private string? FormError { get; set; }

    protected override void OnParametersSet()
    {
        Form ??= new ResetPasswordForm { Email = Email ?? string.Empty, Token = Token ?? string.Empty };
        InvalidLink = string.IsNullOrWhiteSpace(Form!.Email) || string.IsNullOrWhiteSpace(Form!.Token);
        if (InvalidLink)
        {
            HttpContextAccessor.HttpContext?.Response.StatusCode = StatusCodes.Status400BadRequest;
        }
    }

    private async Task SubmitAsync()
    {
        var result = await Recovery.ResetPasswordAsync(Form!.Email, Form!.Token, Form!.NewPassword,
            HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString(), CancellationToken.None);
        Form!.NewPassword = string.Empty;
        Form!.ConfirmPassword = string.Empty;
        if (!result.Succeeded)
        {
            FormError = "This link is invalid or has expired. Request a new one.";
            return;
        }

        Completed = true;
    }
}
