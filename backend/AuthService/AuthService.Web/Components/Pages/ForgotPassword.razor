@page "/auth/password/forgot"
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting("auth")]
@attribute [ResponseCache(NoStore = true, Location = ResponseCacheLocation.None)]
@attribute [ExcludeFromInteractiveRouting]
@inject AccountRecoveryService Recovery

<PageTitle>Forgot password · DS</PageTitle>

@if (Submitted)
{
    <h1 id="page-title">Check your email.</h1>
    <p>If an account exists for that address, we sent a link to reset your password. It expires in 1 hour.</p>
}
else
{
    <h1 id="page-title">Forgot your password?</h1>
    <p>Enter your work email and we'll send you a link to reset it.</p>
    <EditForm FormName="forgot-password" Model="Form!" OnValidSubmit="SubmitAsync" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        <label for="email">Work email</label>
        <InputText id="email" @bind-Value="Form!.Email" autocomplete="username" aria-describedby="email-error" />
        <ValidationMessage For="() => Form!.Email" id="email-error" />
        <button type="submit">Send reset link</button>
    </EditForm>
}

<p class="auth-link"><a href="@SignInUrl">Back to sign in</a></p>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordForm? Form { get; set; }

        private bool Submitted { get; set; }

    private string SignInUrl => $"/auth/sign-in?ReturnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    protected override void OnParametersSet() => Form ??= new();

    private async Task SubmitAsync()
    {
        await Recovery.SendPasswordResetIfEligibleAsync(Form!.Email, CancellationToken.None);
        Submitted = true;
    }
}
