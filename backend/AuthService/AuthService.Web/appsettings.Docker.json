{
  "ConnectionStrings": {
    "AuthServiceDb": "Server=postgres;Port=5432;Database=platform;User Id=postgres;Password=postgres;Search Path=auth,public"
  },
  "Auth": {
    "Issuer": "http://localhost:5130/",
    "SeedAdmin": {
      "Email": "admin@portfolio.local",
      "Password": "ChangeMe123!"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": [
      "Content-Type",
      "Authorization"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ]
  }
}
