{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AuthService": "Information"
    }
  },
  "AllowedHosts": "*",
  "LoadShedding": {
    "Classes": {
      "credentials": {
        "PathPrefixes": [ "/auth/login", "/auth/register", "/auth/forgot-password", "/auth/reset-password", "/connect/token" ],
        "MaxConcurrentRequests": 16,
        "QueueLimit": 16
      }
    }
  }
}
