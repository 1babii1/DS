{
  "ConnectionStrings": {
    "NotificationServiceDb": "Server=postgres;Port=5432;Database=platform;User Id=postgres;Password=postgres;Search Path=notification,public"
  },
  "Auth": {
    "MetadataAddress": "http://auth_service:5130/.well-known/openid-configuration",
    "Issuer": "http://localhost:5130/",
    "Audience": "notification-service"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topics": [ "rewards.events", "auth.events", "employee.events" ],
    "GroupId": "notification-service"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": [
      "Content-Type",
      "Authorization"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ]
  }
}
