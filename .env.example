# Copy this file to .env and adjust values for your environment.
# docker-compose.yml reads every variable below from here, falling back to
# the value shown if .env is absent, so a fresh clone still runs with no setup.

POSTGRES_PASSWORD=postgres

# AuthService seeds this account on first startup (OpenIddictSeeder) so there is
# an admin to log in with locally. Change both before any non-local deployment.
SEED_ADMIN_EMAIL=admin@portfolio.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Only read when the "obs" compose profile is active
# (docker compose --profile obs up) - the observability stack (Tempo/Loki/
# Prometheus/Grafana) is opt-in, not part of the default stack.
GRAFANA_ADMIN_PASSWORD=admin

# AuthService's OpenIddict token signing/encryption keys are self-managed: it generates
# and persists its own RSA keys in the database on first boot and rotates them
# automatically every 30 days (SigningKeyStore/SigningKeyRotationJob) - these variables
# are optional and only matter once, on a deployment's very first startup, to import an
# already-in-use key pair instead of generating a fresh one (which would otherwise
# invalidate every session issued under the old keys). Generate one PEM RSA key per line,
# base64-encoded (two SEPARATE runs - signing and encryption keys must differ):
#   openssl genrsa 2048 | base64 -w0
SIGNINGKEYS_SIGNING_KEY_BASE64=
SIGNINGKEYS_ENCRYPTION_KEY_BASE64=

# Master key that encrypts those private keys inside the database (AES-256-GCM), so a leaked
# database/backup alone does not hand over the keys that sign and decrypt every token. Exactly
# 32 random bytes, base64: openssl rand -base64 32 . REQUIRED when ASPNETCORE_ENVIRONMENT is
# Production (AuthService refuses to start without it); optional for local/Docker, where an
# empty value keeps the keys as plaintext and logs a warning. Keep it in the secrets vault, never
# in the database. Losing it makes the stored keys unreadable (every session/refresh token
# is invalidated); changing it needs a re-encryption pass that is not implemented yet.
SIGNINGKEYS_AT_REST_KEY_BASE64=

# Redis requires this password once ACL/requirepass is enabled (see
# docker-compose.yml's redis service) - every service caching through it
# (currently DirectoryService's HybridCache) reads the same value.
REDIS_PASSWORD=changeme-redis

# Kafka's broker listener requires SASL/PLAIN once set (see docker-compose.yml's
# kafka service) - every producer (DirectoryService, EmployeeService, via the shared
# outbox publisher) and consumer (AuditService, NotificationService) authenticates
# with this same shared credential; there's no per-service identity, just one trusted
# account, matching the single-broker/no-ACL scale of this deployment.
KAFKA_PASSWORD=changeme-kafka

# The frontend's own origin - every backend service's CORS policy allows
# exactly this one browser origin to call it directly (service-to-service
# calls, e.g. EmployeeService -> DirectoryService over gRPC, are not affected
# by CORS at all; it only ever governs browser-originated requests).
FRONTEND_ORIGIN=http://localhost:3000

# AuthService's outgoing SMTP - used to email a newly hired employee their
# generated password (Hire Employee saga, EmployeeEventsConsumer). Empty = falls
# back to mailpit (docker-compose.yml), a local catch-all with no real delivery -
# view what was "sent" at localhost:8025. Set these to send for real; provider is
# Yandex Mail over SMTP.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USE_SSL=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# The confidential OIDC client (client_id=portfolio-web) the Next.js/Auth.js BFF
# authenticates as - always enabled, since the frontend depends on it to sign
# users in at all. AUTH_OIDC_CLIENT_SECRET is read by both AuthService and the
# frontend (frontend/.env.example) - it's the same secret, not two.
# Generate one with: openssl rand -base64 32
AUTH_WEB_CLIENT_FRONTEND_ORIGIN=http://localhost:3000
AUTH_OIDC_CLIENT_SECRET=

# "Sign in with Google" - empty disables the feature entirely (SignIn/Register simply don't
# show the button, AddGoogle() is never registered). From a Google Cloud Console OAuth
# client (Web application type); redirect URI to register there is
# {AUTH_ISSUER}/auth/external/google/callback.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
